# =============== #
# Unity .gitignore #
# =============== #

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
Recordings/
UserSettings/
sysinfo.txt

# Android / iOS / Gradle
*.apk
*.aab
*.keystore
*.jks
.gradle/
gradle.properties

# Visual Studio
*.csproj
*.sln
*.user
.vs/

# Unity Cache
/[Uu]serSettings/
PackageCache/
*.cache

# Auto-generated
*.pidb
*.booproj
*.unityproj
*.svd
*.pdb
*.mdb

# Crash Reports
*.stacktrace

# ========================================= #
# Archivos de Gran Tamaño y Bases de Datos  #
# ========================================= #
# Ignorar archivos que exceden los 100MB de GitHub
*.zip
*.7z
*.rar
*.mp4
*.mov
*.psd
*.fbx
*.obj

# Bases de datos locales y temporales
*.sql
*.sqlite
*.db
*.localdb
/Assets/Plugins/Android/*.aar
/Assets/Plugins/iOS/*.framework

# Archivos pesados de Firebase o servicios
google-services.json
GoogleService-Info.plist